# macOS
.DS_Store

# SwiftPM
.build/
.swiftpm/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# Build outputs
dist/

# Local module cache used by scripts/package-app.sh
**/module-cache/

# Design assets workspace (uploads, exports). Treat as untracked so
# git add -A doesn't sweep large binary blobs into source commits.
CrateDigger_DESIGN/

# Local secrets (Last.fm API credentials, etc.) consumed at package time.
# Never commit these — see scripts/lastfm.env.example.
scripts/.lastfm.env
.env
.env.local

# Claude Code local session state (permissions, worktrees).
.claude/

# Agent tooling scratch (session diffs, task reports, local tokens). Never
# source — and .superpowers/brainstorm/.last-token is a credential.
.superpowers/

# Coverage artifact dropped by a raw `swift test` run in the repo root.
default.profraw
