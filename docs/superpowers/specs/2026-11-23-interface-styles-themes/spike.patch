+// SPIKE: the interface style owns how round the console's slabs are.
+private func styledGeometry(_ g: CarbonGeometry) -> CarbonGeometry {
+    var g = g
+    let k = InterfaceStyle.current.radiusScale
+    g.keyCornerRadius *= k
+    g.wellCornerRadius *= k
+    g.paperCornerRadius *= k
+    return g
+}
diff --git a/Sources/CrateDiggerApp/UI/Theme/InterfaceStyle.swift b/Sources/CrateDiggerApp/UI/Theme/InterfaceStyle.swift
new file mode 100644
index 00000000..aad7be7f
--- /dev/null
+++ b/Sources/CrateDiggerApp/UI/Theme/InterfaceStyle.swift
@@ -0,0 +1,175 @@
+import SwiftUI
+
+// SPIKE — throwaway. Picked at launch by CRATEDIGGER_STYLE=soft|sticker|toy|real.
+// Exists only so the owner can see the four styles in the real app.
+
+enum InterfaceStyle: String {
+    case soft, sticker, toy, real
+
+    static let current: InterfaceStyle =
+        InterfaceStyle(rawValue: ProcessInfo.processInfo.environment["CRATEDIGGER_STYLE"] ?? "") ?? .real
+
+    var isReal: Bool { self == .real }
+
+    /// How much rounder this style's keys, wells and panels are than the theme's own radii.
+    var radiusScale: CGFloat {
+        switch self {
+        case .soft: return 2.0
+        case .sticker: return 1.35
+        case .toy: return 1.4
+        case .real: return 1
+        }
+    }
+}
+
+extension CarbonTheme {
+    /// SPIKE: print on the small chassis keys that read `ink3`/`ink2` today. A theme that
+    /// sets `chassisInk` means it for every key, so those follow it; unset, nothing moves.
+    func keyPrint(_ fallback: Color) -> Color { chassisInkOverride ?? fallback }
+
+    /// The die-cut outline and hard shadow of the Sticker style.
+    var stickerInk: Color {
+        if let stickerInkOverride { return stickerInkOverride }
+        if isDark && ProcessInfo.processInfo.environment["CRATEDIGGER_STICKER_INK"] == "light" { return chassisInk.opacity(0.85) }
+        return isDark ? Color.black.opacity(0.92) : ink.opacity(0.9)
+    }
+}
+
+private struct StyledPressedKey: EnvironmentKey { static let defaultValue = false }
+
+extension EnvironmentValues {
+    var styledPressed: Bool {
+        get { self[StyledPressedKey.self] }
+        set { self[StyledPressedKey.self] = newValue }
+    }
+}
+
+/// One slab of the console in the current (non-Real) style: a key, a well, a panel.
+/// The button style moves the key; the slab draws the shadow it moves onto.
+struct StyledSlab<S: Shape>: View {
+    @Environment(\.carbon) private var theme
+    @Environment(\.styledPressed) private var pressed
+    let shape: S
+    let fill: Color
+    var hi: Color? = nil
+    var lo: Color? = nil
+    /// Sticker: how far the hard shadow sits; Toy: how tall the lower lip is.
+    var depth: CGFloat = 2.5
+    /// A well is cut in, not stuck on: Toy lights its lower lip instead of its upper one.
+    var sunken = false
+    var outline: CGFloat = 2
+
+    var body: some View {
+        switch InterfaceStyle.current {
+        case .soft, .real:
+            shape.fill(fill)
+        case .sticker:
+            ZStack {
+                shape.fill(theme.stickerInk)
+                    .offset(x: pressed ? 0 : depth, y: pressed ? 0 : depth)
+                shape.fill(fill)
+                    .overlay(shape.stroke(theme.stickerInk, lineWidth: outline * 2).clipShape(shape))
+            }
+        case .toy:
+            if sunken { toyWell } else { toyKey }
+        }
+    }
+}
+
+extension StyledSlab {
+    /// A chunky key: a lit top face sitting on its own darker body, which
+    /// shows as a band below the cap. A press drops the cap onto the body.
+    @ViewBuilder fileprivate var toyKey: some View {
+        let top = hi ?? fill
+        let base = lo ?? fill
+        ZStack {
+            shape.fill(base)
+                .overlay(shape.fill(Color.black.opacity(theme.isDark ? 0.38 : 0.16)))
+                .offset(y: pressed ? 0 : depth)
+                .shadow(color: Color.black.opacity(theme.isDark ? 0.45 : 0.16),
+                        radius: pressed ? 0.5 : 1.2, y: pressed ? 0.5 : 1.5)
+            // The highlight only lifts the top half of the cap, at half strength:
+            // a full `hi` → `fill` ramp paled dark themes' keys (Llama '97 dark)
+            // until their printed glyphs washed out.
+            shape
+                .fill(fill)
+                .overlay(shape.fill(LinearGradient(colors: [top.opacity(0.5), top.opacity(0)],
+                                                   startPoint: .top, endPoint: .center)))
+                .overlay(
+                    shape.stroke(
+                        LinearGradient(colors: [Color.white.opacity(theme.isDark ? 0.22 : 0.85), .clear],
+                                       startPoint: .top, endPoint: .center),
+                        lineWidth: 2
+                    )
+                    .clipShape(shape)
+                )
+        }
+    }
+
+    /// A well cut into the case: shaded under its top edge, lit along its bottom.
+    @ViewBuilder fileprivate var toyWell: some View {
+        let bottom = lo ?? fill
+        shape
+            .fill(LinearGradient(colors: [bottom, fill, fill], startPoint: .top, endPoint: .bottom))
+            .overlay(
+                shape.stroke(LinearGradient(colors: [Color.black.opacity(theme.isDark ? 0.55 : 0.28), .clear],
+                                            startPoint: .top, endPoint: .center), lineWidth: 5)
+                    .clipShape(shape)
+            )
+            .overlay(
+                shape.stroke(LinearGradient(colors: [.clear, Color.white.opacity(theme.isDark ? 0.14 : 0.7)],
+                                            startPoint: .center, endPoint: .bottom), lineWidth: 3)
+                    .clipShape(shape)
+            )
+    }
+}
+
+/// How a key answers a press in each style. Real keeps whatever the caller did.
+struct StyledPress: ViewModifier {
+    let pressed: Bool
+    var depth: CGFloat = 2.5
+
+    func body(content: Content) -> some View {
+        content
+            .environment(\.styledPressed, pressed)
+            .scaleEffect(InterfaceStyle.current == .soft && pressed ? 0.95 : 1)
+            .offset(x: InterfaceStyle.current == .sticker && pressed ? depth : 0,
+                    y: offsetY)
+            .animation(InterfaceStyle.current == .soft
+                       ? .spring(response: 0.18, dampingFraction: 0.55)
+                       : CarbonMotion.press, value: pressed)
+    }
+
+    private var offsetY: CGFloat {
+        switch InterfaceStyle.current {
+        case .sticker: return pressed ? depth : 0
+        case .toy: return pressed ? depth : 0
+        default: return 0
+        }
+    }
+}
+
+/// `carbonHover` plus the style's press, for keys drawn with `StyledSlab`.
+struct StyledKeyButtonStyle: ButtonStyle {
+    var depth: CGFloat = 2.5
+    func makeBody(configuration: Configuration) -> some View {
+        KeyBody(configuration: configuration, depth: depth)
+    }
+
+    private struct KeyBody: View {
+        let configuration: Configuration
+        let depth: CGFloat
+        @Environment(\.carbon) private var theme
+        @Environment(\.isEnabled) private var isEnabled
+        @State private var hovering = false
+
+        var body: some View {
+            configuration.label
+                .brightness(configuration.isPressed ? (theme.isDark ? -0.05 : -0.04)
+                            : hovering ? (theme.isDark ? 0.07 : 0.03) : 0)
+                .modifier(StyledPress(pressed: configuration.isPressed, depth: depth))
+                .animation(CarbonMotion.hover, value: hovering)
+                .onHover { hovering = $0 && isEnabled }
+        }
+    }
+}
