        <item>
            <title>2.2.2</title>
            <pubDate>Fri, 25 Sep 2026 18:00:26 -0300</pubDate>
            <link>https://cratedigger.mrbarkan.com/</link>
            <sparkle:fullReleaseNotesLink>https://github.com/mrbarkan/cratedigger/releases</sparkle:fullReleaseNotesLink>
